# Default: isolated fictional PWA only. No remote services are used in this mode.
ROSE_STAFF_ENABLED=false

# Optional authenticated fixture workspace. Server-only, with a local or approved test stack.
ROSE_APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# A connection for rose_care_app only. Never use postgres, a service role, or a production secret.
ROSE_DATABASE_URL=
# Generate a random value with at least 43 characters, for example openssl rand -hex 32.
ROSE_FLOW_SECRET=
